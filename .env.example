# Copy this file to .env and fill in the keys you have.
# Every code.py example checks for the keys it needs and prints a clear
# message (instead of crashing) if one is missing.

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tools used in examples (Phase 1+) ---
# Free tier / no key needed for DuckDuckGo search tool used in examples.
TAVILY_API_KEY=

# --- LangSmith (tracing / eval — Phase 9, optional earlier) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langchain-ecosystem-course

# --- Local models (Phase 2) ---
OLLAMA_BASE_URL=http://localhost:11434
